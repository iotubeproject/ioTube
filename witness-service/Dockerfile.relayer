FROM golang:1.27-alpine as build

WORKDIR apps/iotube-relayer

RUN apk add --no-cache make gcc musl-dev linux-headers git

COPY go.mod .
COPY go.sum .

RUN go mod download

COPY . .

# build version (the build context has no .git); see the Makefile
ARG VERSION
ARG COMMIT
ARG GIT_STATUS
ARG BUILD_TIME

RUN mkdir -p $GOPATH/pkg/linux_amd64/github.com/iotexproject/ && \
    make clean build-relayer ${VERSION:+VERSION=$VERSION} ${COMMIT:+COMMIT=$COMMIT} \
        ${GIT_STATUS:+GIT_STATUS=$GIT_STATUS} ${BUILD_TIME:+BUILD_TIME=$BUILD_TIME}

FROM alpine:latest

RUN apk add --no-cache ca-certificates
RUN mkdir -p /etc/iotube/
COPY --from=build /go/apps/iotube-relayer/bin/relayer /usr/local/bin/relayer

CMD [ "relayer" ]
