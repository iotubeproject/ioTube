# ioTube witness settings. Copy this file to .env (same directory as
# docker-compose.yml), fill in the REQUIRED values, then: docker compose up -d
# After any change: docker compose up -d --force-recreate

# Witness image version. A fixed release; never latest.
WITNESS_TAG=7.4.0

# Routes to run, comma-separated:
# iotex-to-bsc, bsc-to-iotex, iotex-to-polygon, polygon-to-iotex
COMPOSE_PROFILES=iotex-to-bsc,bsc-to-iotex

# Local database. mariadb:11.4 needs about 85 MB of memory, mysql:8 about
# 420 MB. Keep the engine that created data/mysql.
WITNESS_DB_IMAGE=mariadb:11.4
# REQUIRED. For example: openssl rand -hex 16
DB_ROOT_PASSWORD=

# REQUIRED. Relayer host, from the bridge operators.
RELAYER_URL=

# REQUIRED: one of the two. AWS KMS keeps the key out of this host
# (see README "Signing with AWS KMS"); with KMS leave WITNESS_PRIVATE_KEY empty.
WITNESS_PRIVATE_KEY=
WITNESS_KMS_KEY_ID=
WITNESS_KMS_REGION=

# RPC endpoints of the source chains of the routes you run. They must serve
# eth_getLogs and receipts for at least the last few days; BSC's public
# bsc-dataseed endpoints do not.
IOTEX_RPC_URL=https://babel-api.mainnet.iotex.io
BSC_RPC_URL=
POLYGON_RPC_URL=

# First block to scan per route. The bridge operators give current values;
# older heights mean a long initial scan.
IOTEX_TO_BSC_START_HEIGHT=48300000
BSC_TO_IOTEX_START_HEIGHT=99705816
IOTEX_TO_POLYGON_START_HEIGHT=48300000
POLYGON_TO_IOTEX_START_HEIGHT=87000000

# Optional sign policy (README "Sign policy"). Certificate files go in
# ./signpolicy/ and are referenced as /etc/iotube-witness/signpolicy/<file>.
# It applies to every route; only the listed cashiers are gated.
WITNESS_SIGN_POLICY_URL=
WITNESS_SIGN_POLICY_CASHIERS=
WITNESS_SIGN_POLICY_CLIENT_CERT=
WITNESS_SIGN_POLICY_CLIENT_KEY=
WITNESS_SIGN_POLICY_CA=

# Optional TLS to the relayer (README "Relayer TLS"); only when the bridge
# operators say the relayer uses TLS. Files go in ./relayer-tls/ and are
# referenced as /etc/iotube-witness/relayer-tls/<file>.
RELAYER_TLS_CA_FILE=
RELAYER_TLS_CERT_FILE=
RELAYER_TLS_KEY_FILE=
RELAYER_TLS_SERVER_NAME=
