# Witness deploy configuration.
# start_witness.sh creates <data-dir>/etc/.env next to the deployed
# docker-compose.yml and fills it in; edit that file afterwards. Settings for the
# first run are passed as environment variables, e.g.
#   WITNESS_DB_IMAGE=mariadb:11.4 ./start_witness.sh
# Without the script, copy this file to .env next to the compose file you run.
#
# The REQUIRED values below are guarded in the compose file: if one is left
# blank, `docker compose up` fails immediately telling you which one to set,
# instead of silently mounting empty dirs over the config files and crash-looping.

# REQUIRED. Absolute path to the witness deploy directory. Must contain `etc/`
# (the witness-config-*.yaml files) and `data/` (the MySQL data dir).
# Example: IOTEX_WITNESS=/home/deploy/iotex-witness
IOTEX_WITNESS=

# REQUIRED. MySQL root password for the local witness-db container.
DB_ROOT_PASSWORD=

# REQUIRED. Witness image version to run: a release tag such as 7.2.0 (see
# https://github.com/iotubeproject/ioTube/releases). Do not use `latest`: it
# moves with every release. To upgrade or roll back, change it and run
# ./upgrade.sh.
WITNESS_TAG=7.2.0

# Database image for the local witness-db: mysql:8 (default) or mariadb:11.4,
# which needs much less memory (about 85 MB idle vs 420 MB). start_witness.sh
# records the choice in <data-dir>/etc/.env at first setup (from the
# WITNESS_DB_IMAGE environment variable, default mysql:8) and refuses an image
# that cannot open the existing data dir: switching engines needs a dump and
# restore.
WITNESS_DB_IMAGE=mysql:8

# Optional. Only needed if you inject the witness signing key / relayer address via
# environment variables instead of the *.secret.yaml files. Leave blank when using
# file-based secrets (the recommended setup).
WITNESS_PRIVATE_KEY=
RELAYER_URL=